{#
heading.jinja

Parameters:
    * heading_anchor_id
    * heading_extra_classes
    * heading_level (Must start at 2 !)
    * heading_icon
    * heading_inner_html
    // * heading_right_html
    * heading_spacing_class: Optional[str]
#}

{% if heading_spacing_class is not defined %}
    {% if heading_level == 3 %}
        {% set heading_spacing_class="mt-l" %}
    {% elif heading_level == 4 %}
        {% set heading_spacing_class="mt-m" %}
    {% else %}
        {% set heading_spacing_class="  " %}
    {% endif %}
{% endif %}
{% set heading_spacing_class=" " + heading_spacing_class + " " %}

{% if heading_anchor_id is not none %}
    <a class="bland-link" href="#{{ heading_anchor_id }}"></a>
{% endif %}

<div class="heading-main p-xs border r-s bkgd-grid
        {{ heading_spacing_class }}
        {{ heading_extra_classes }}
        mt-0-if-first">

    <h{{ heading_level }} class="t-w-500
            {% if heading_level == 2 %}
                 t-size-16
            {% else %}
                {% if heading_level == 3 %}
                    t-size-12
                {% else %}
                    t-size-10
                {% endif %}
            {% endif %}">

        {% if heading_icon is not none %}
            <i class="{{ heading_icon }} t-muted"></i>
        {% endif %}

        {{ heading_inner_html }}

        {% if heading_right_html is not none %}
            <!--<span class="ml-auto mobile-hide t-size-10 t-muted">{{ heading_right_html }}</span>-->
        {% endif %}

    </h{{ heading_level }}>
</div>
