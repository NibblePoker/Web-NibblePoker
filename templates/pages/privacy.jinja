{% if is_standalone %}
    {# Should never happen for non-tool pages ! #}
    {% extends "bases/standalone.jinja" %}
{% else %}
    {% extends "bases/default.jinja" %}
{% endif %}

{% block head_title %}{{ l10n("head.title", "privacy", page_lang) }}{% endblock %}

{% block head_description %}
    <!-- IRRELEVANT, shove it in the opengraph section !!! -->
    {{ l10n("head.title", "privacy", page_lang) }}
{% endblock %}

{% block opengraph_tags %}
    <!-- TODO -->
{% endblock %}

{% block main_content %}
    <!-- Introduction -->
    <np-section>
        {% with heading_inner_html=l10n("introduction.title", "privacy", page_lang, ""),
                heading_level=2,
                heading_icon="fad fa-info" %}
            {% include 'elements/heading.jinja' %}
        {% endwith %}
        <np-content-spacer>
            <np-paragraph>
                {{ l10n("introduction.text.1", "privacy", page_lang) }}
            </np-paragraph>
            <np-paragraph>
                {{ l10n("introduction.text.2", "privacy", page_lang) }}<br>
                <i class="fad fa-globe ml-s t-size-8"></i><a href="https://gdpr.eu/privacy-notice/" class="ml-xs">https://gdpr.eu/</a><br>
                <i class="fad fa-globe ml-s t-size-8"></i><a href="https://eur-lex.europa.eu/legal-content/ALL/?uri=CELEX%3A32016R0679" class="ml-xs">https://eur-lex.europa.eu/</a>
            </np-paragraph>
        </np-content-spacer>
    </np-section>

    <!-- Data collection (Web) -->
    <np-section>
        {% with heading_inner_html=l10n("data.title", "privacy", page_lang, ""),
                heading_level=2,
                heading_icon="fad fa-database" %}
            {% include 'elements/heading.jinja' %}
        {% endwith %}
