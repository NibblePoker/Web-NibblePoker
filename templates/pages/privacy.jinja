            <np-paragraph>
                {{ l10n("data.intro.1", "privacy", page_lang) }}<br>
                {{ l10n("data.intro.2", "privacy", page_lang) }}
            </np-paragraph>

            <np-paragraph>
                {{ l10n("data.private.text.1", "privacy", page_lang) }}<br>
                <np-ul>
                    <li>{{ l10n('data.private.list.1', "privacy", page_lang) }}</li>
                    <li>{{ l10n('data.private.list.2', "privacy", page_lang) }}</li>
                </np-ul>
            </np-paragraph>

            <np-paragraph>
                {{ l10n("data.non_private.text.1", "privacy", page_lang) }}<br>
