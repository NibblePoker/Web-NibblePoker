{#
pages/project.jinja

Parameter:
    * project_id - Project ID for which the page should be rendered.

Notable globals:
    * projects_index
#}

{% set project_data=projects_index[project_id] %}

{% if is_standalone %}
    {% extends "bases/standalone.jinja" %}
{% else %}
    {% extends "bases/default.jinja" %}
{% endif %}

{% block head_title %}{{ l10n("head.title", "home", page_lang) }}{% endblock %}

{% block head_description %}
    <!-- IRRELEVANT, shove it in the opengraph section !!! -->
    {{ l10n("head.title", "home", page_lang) }}
{% endblock %}

{% block opengraph_tags %}
    <!-- TODO -->
{% endblock %}

{% block header_title %}
    <i class="fad fa-briefcase t-size-16 mr-s t-muted"></i><a href="{{ url_set_lang('/content/', url_lang) }}" class="a-hidden">{{ l10n("header.root", "projects", page_lang) }}</a>
    <span class="mobile-hide"><span class="mx-s t-size-15">❱</span>{{ l10n(project_data.metadata.general.title_key, project_id, page_lang) }}</span>
{% endblock %}

{% block main_content %}
    {% with heading_inner_html=l10n("meta.title", project_id, page_lang),
            heading_level=2 %}
        {% include 'elements/heading.jinja' %}
    {% endwith %}

    <np-content-spacer>
        {% block project_content %}{% endblock %}
    </np-content-spacer>
{% endblock %}

{% block extra_scripts %}
    <script src="/resources/NibblePoker/js/nibblepoker-default.min.js"></script>
{% endblock %}
